# PostgreSQL used by Prisma-backed consultation bookings and commerce records.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aurelia?schema=public"

# Optional Redis connection for 15-minute high-value inventory reservations.
REDIS_URL="redis://localhost:6379"

# Override illustrative fallback pricing inputs with your market-rate provider.
METAL_RATE_YELLOW_GOLD_14K=""
METAL_RATE_YELLOW_GOLD_18K=""
METAL_RATE_YELLOW_GOLD_22K=""
METAL_RATE_WHITE_GOLD_14K=""
METAL_RATE_WHITE_GOLD_18K=""
METAL_RATE_ROSE_GOLD_14K=""
METAL_RATE_PLATINUM=""
